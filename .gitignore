# Build output
build/
*.o
*.d

# Generated for clang-tidy by `make lint`. Holds absolute paths and, on macOS,
# an SDK path, so it describes one machine rather than the project.
compile_commands.json

# Indexes an editor builds from the above, and rebuilds as readily.
.cache/

# The documentation site, rendered from docs/ by mkdocs and served from a
# branch of its own rather than from here.
site/

# Program output
*.h5

# Test data. The alignments alone are over 100 MB, which does not belong in
# git history; keep them alongside the checkout or fetch them separately.
data/

# macOS
.DS_Store

# Test dependencies. The lockfile is ignored rather than pinned because
# `uv pip install` does not read one, and Python here is the test harness
# rather than anything the program ships.
.venv/
.pytest_cache/
__pycache__/
uv.lock
