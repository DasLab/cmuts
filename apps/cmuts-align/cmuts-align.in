#!/usr/bin/env bash
#
# cmuts-align -- alignment helper for the cmuts pipeline.
#
# Author: Hamish M. Blair <hmblair@stanford.edu>

set -euo pipefail

PROGRAM="cmuts-align"
VERSION="@VERSION@"  # substituted from include/version.h
SUMMARY="align reads to a reference and sort the resulting alignments."

# BAM stores a read name's length in one byte, so the name and its terminating
# NUL must fit in 255.
NAME_LIMIT=254

# Presets that will reject paired-end sequences
LONG_READ_PRESETS="map-ont map-hifi map-pb lr:hq ava-ont ava-pb"

# The formats holding reads this program aligns.
FORMAT_FASTQ="fastq"
FORMAT_BAM="bam"

# The bytes each format begins with. A BAM is gzip compressed, as a FASTQ may
# be, so both are read after decompression.
GZIP_MAGIC=$'\x1f\x8b'
BAM_MAGIC=$'BAM\x01'
FASTQ_MAGIC="@"

# The bit a record sets when its read is one of a pair.
PAIRED_BIT=1

# The presets listed by the help and by --dump-options. minimap2 accepts more, and
# validates the value.
PRESETS="sr|map-ont|map-hifi|map-pb"

# Headings for the option groups, used by both the help and --dump-options.
GROUP_IO="Input and output"
GROUP_ALIGNMENT="Alignment"
GROUP_PERFORMANCE="Performance"
GROUP_INFORMATION="Information"

HELP_READS="reads to align, as FASTQ or unaligned BAM"
HELP_MATE="the second file of a pair, merged with the first"
HELP_FASTA="reference sequences"
HELP_OUTPUT="write sorted alignments to this file"
HELP_OVERWRITE="replace the output file if it already exists"
HELP_PRESET="how minimap2 aligns"
HELP_THREADS="threads for merging, alignment and sorting"
HELP_HELP="show this help and exit"
HELP_VERSION="show the version and exit"
HELP_DUMP_OPTIONS="describe every argument as JSON and exit"

THREADS_DEFAULT=1

# fastp accepts no more threads than this.
MERGE_THREADS_MAX=16

# The arguments as the usage line and the count message write them.
ARGUMENTS="READS [MATE]"

die() {
    printf '%s: %s\n' "$PROGRAM" "$1" >&2
    exit 2
}

missing() {
    die "missing required option --$1 ($2)"
}

# The help column is a floor of 28, widened by any invocation longer than it.
# No invocation here reaches that, so the floor is what every row is set to.
option() {
    printf '  %-28s %s\n' "$1" "$2"
}

usage() {
    printf '%s %s -- %s\n\n' "$PROGRAM" "$VERSION" "$SUMMARY"
    printf 'usage: %s [options] -f FASTA -o BAM -x PRESET %s\n' "$PROGRAM" "$ARGUMENTS"

    printf '\nArguments\n'
    option "READS" "$HELP_READS"
    option "MATE" "$HELP_MATE"

    printf '\n%s\n' "$GROUP_IO"
    option "-f, --fasta FASTA" "$HELP_FASTA"
    option "-o, --output BAM" "$HELP_OUTPUT"
    option "    --overwrite" "$HELP_OVERWRITE"

    printf '\n%s\n' "$GROUP_ALIGNMENT"
    option "-x, --preset PRESET" "$HELP_PRESET ($PRESETS)"

    printf '\n%s\n' "$GROUP_PERFORMANCE"
    option "-t, --threads N" "$HELP_THREADS (default $THREADS_DEFAULT)"

    printf '\n%s\n' "$GROUP_INFORMATION"
    option "-h, --help" "$HELP_HELP"
    option "-V, --version" "$HELP_VERSION"
}

# Prints a JSON string, or null for an empty value. A backslash or a quote would
# end the string early, so both are escaped.
json_string() {
    local text=$1

    if [[ -z $text ]]; then
        printf 'null'
        return
    fi

    text=${text//\\/\\\\}
    text=${text//\"/\\\"}

    printf '"%s"' "$text"
}

# Prints the values an option accepts as a JSON array, from the same bar
# separated list the help prints. An empty list prints null.
json_choices() {
    local list=$1 first=true choice

    if [[ -z $list ]]; then
        printf 'null'
        return
    fi

    printf '['

    for choice in ${list//|/ }; do
        [[ $first == true ]] && first=false || printf ', '
        json_string "$choice"
    done

    printf ']'
}

# Prints the members of a JSON array, separated by commas.
join_json() {
    local first=true member

    for member in "$@"; do
        [[ $first == true ]] && first=false || printf ',\n'
        printf '%s' "$member"
    done
}

# Prints one option, in the shape cli.c gives it. The first six arguments are
# the group, the long name, the short form, the type, the metavar, and the help.
# Any of `required`, `hidden`, `choices=A|B`, `default=V`, `minimum=N`, and
# `maximum=N` may follow, in place of the designated initializers a compiled
# subcommand's table uses. A field left out is printed as null.
option_json() {
    local group=$1 name=$2 short=$3 type=$4 metavar=$5 help=$6
    local required=false hidden=false choices="" default=null
    local minimum=null maximum=null
    local field

    shift 6

    for field in "$@"; do
        case "$field" in
            required)  required=true                ;;
            hidden)    hidden=true                  ;;
            choices=*) choices=${field#choices=}    ;;
            default=*) default=${field#default=}    ;;
            minimum=*) minimum=${field#minimum=}    ;;
            maximum=*) maximum=${field#maximum=}    ;;
            *)         die "option_json: unknown field $field" ;;
        esac
    done

    printf '    {
      "name": %s,
      "short": %s,
      "group": %s,
      "type": %s,
      "metavar": %s,
      "help": %s,
      "required": %s,
      "hidden": %s,
      "repeatable": false,
      "unset_label": null,
      "choices": %s,
      "default": %s,
      "minimum": %s, "maximum": %s
    }' "$(json_string "$name")" "$(json_string "$short")" "$(json_string "$group")" \
       "$(json_string "$type")" "$(json_string "$metavar")" "$(json_string "$help")" \
       "$required" "$hidden" "$(json_choices "$choices")" "$default" "$minimum" "$maximum"
}

# Prints one positional argument, in the same shape. Neither takes every
# remaining word, so neither is variadic.
positional_json() {
    local name=$1 metavar=$2 help=$3 required=$4

    printf '    {
      "name": %s,
      "metavar": %s,
      "help": %s,
      "required": %s,
      "variadic": false
    }' "$(json_string "$name")" "$(json_string "$metavar")" "$(json_string "$help")" \
       "$required"
}

# Prints the command line as JSON, in the shape a compiled subcommand's
# --dump-options gives it, so that one reader covers every program of the suite.
dump_options() {
    local options positionals

    options=(
        "$(option_json "$GROUP_IO" fasta f string FASTA "$HELP_FASTA" required)"
        "$(option_json "$GROUP_IO" output o string BAM "$HELP_OUTPUT" required)"
        "$(option_json "$GROUP_IO" overwrite "" flag "" "$HELP_OVERWRITE" default=false)"
        "$(option_json "$GROUP_ALIGNMENT" preset x string PRESET "$HELP_PRESET" \
                       required "choices=$PRESETS")"
        "$(option_json "$GROUP_PERFORMANCE" threads t int N "$HELP_THREADS" \
                       "default=$THREADS_DEFAULT" minimum=1)"
        "$(option_json "$GROUP_INFORMATION" help h flag "" "$HELP_HELP")"
        "$(option_json "$GROUP_INFORMATION" version V flag "" "$HELP_VERSION")"
        "$(option_json "$GROUP_INFORMATION" dump-options "" flag "" "$HELP_DUMP_OPTIONS" hidden)"
    )

    positionals=(
        "$(positional_json reads READS "$HELP_READS" true)"
        "$(positional_json mate MATE "$HELP_MATE" false)"
    )

    printf '{\n'
    printf '  "program": %s,\n' "$(json_string "$PROGRAM")"
    printf '  "version": %s,\n' "$(json_string "$VERSION")"
    printf '  "summary": %s,\n' "$(json_string "$SUMMARY")"
    printf '  "options": [\n'
    join_json "${options[@]}"
    printf '\n  ],\n  "positionals": [\n'
    join_json "${positionals[@]}"
    printf '\n  ]\n}\n'
}

fasta=""
output=""
preset=""
threads=$THREADS_DEFAULT
overwrite=false
reads=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -V|--version)
            printf '%s %s\n' "$PROGRAM" "$VERSION"
            exit 0
            ;;
        --dump-options)
            dump_options
            exit 0
            ;;
        -f|--fasta)
            [[ $# -ge 2 ]] || die "$1 needs a value"
            fasta=$2
            shift 2
            ;;
        -o|--output)
            [[ $# -ge 2 ]] || die "$1 needs a value"
            output=$2
            shift 2
            ;;
        -x|--preset)
            [[ $# -ge 2 ]] || die "$1 needs a value"
            preset=$2
            shift 2
            ;;
        -t|--threads)
            [[ $# -ge 2 ]] || die "$1 needs a value"
            threads=$2
            shift 2
            ;;
        --overwrite)
            overwrite=true
            shift
            ;;
        --)
            shift
            while [[ $# -gt 0 ]]; do
                reads+=("$1")
                shift
            done
            ;;
        -*)
            die "unrecognized option $1"
            ;;
        *)
            reads+=("$1")
            shift
            ;;
    esac
done

[[ -n $fasta ]]  || missing fasta "$HELP_FASTA"
[[ -n $output ]] || missing output "$HELP_OUTPUT"
[[ -n $preset ]] || missing preset "$HELP_PRESET"

if [[ ${#reads[@]} -eq 0 || ${#reads[@]} -gt 2 ]]; then
    die "expected $ARGUMENTS, got ${#reads[@]} arguments"
fi

if [[ ${#reads[@]} -eq 2 ]]; then
    case " $LONG_READ_PRESETS " in
        *" $preset "*) die "--preset: $preset reads do not come in pairs" ;;
    esac
fi

[[ $threads =~ ^[1-9][0-9]*$ ]] || die "--threads: $threads is below 1"

tools=(minimap2 samtools)

if [[ ${#reads[@]} -eq 2 ]]; then
    tools+=(fastp)
fi

for tool in "${tools[@]}"; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is not on PATH"
done

[[ -r $fasta ]] || die "cannot read $fasta"

# minimap2 would accept an index, but the reference checksums need the bases,
# which an index does not hold.
if [[ $(head -c 4 "$fasta") == $'MMI\x02' ]]; then
    die "--fasta: $fasta is a minimap2 index; pass the FASTA it was built from"
fi

# The first bytes of a file, decompressed where it is gzip compressed, so that
# a BAM and a compressed FASTQ are both read as what they hold.
leading_bytes() {
    local file=$1 count=$2

    if [[ $(head -c 2 "$file" 2>/dev/null) == "$GZIP_MAGIC" ]]; then
        command -v gzip >/dev/null 2>&1 || die "gzip is not on PATH"
        gzip -dc < "$file" 2>/dev/null | head -c "$count" || true
    else
        head -c "$count" "$file" 2>/dev/null || true
    fi
}

# The format of a file, or nothing where it holds neither reads this program
# aligns. Passing an unreadable format on would feed bytes to the aligner that
# it reports far from where the mistake was made.
format_of() {
    case "$(leading_bytes "$1" 4)" in
        "$BAM_MAGIC"*)   printf '%s' "$FORMAT_BAM"   ;;
        "$FASTQ_MAGIC"*) printf '%s' "$FORMAT_FASTQ" ;;
    esac
}

# Whether a BAM names the references its reads were placed against. Alignments
# are what cmuts hmm counts, so this program has nothing left to do with them.
names_references() {
    local header
    header=$(samtools view -H "$1" 2>/dev/null || true)

    grep -q '^@SQ' <<< "$header"
}

# Whether a BAM's first record marks its read as one of a pair. The reads of a
# pair come back interleaved, which minimap2 does not read as mates.
holds_pairs() {
    local flag
    flag=$(samtools view "$1" 2>/dev/null | head -1 | cut -f 2 || true)

    [[ $flag =~ ^[0-9]+$ ]] && (( (flag & PAIRED_BIT) != 0 ))
}

formats=()

for file in "${reads[@]}"; do
    [[ -r $file ]] || die "cannot read $file"

    format=$(format_of "$file")
    [[ -n $format ]] || die "$file is neither a FASTQ nor a BAM"

    formats+=("$format")
done

# A BAM holds every read of a run, including both mates of a pair, so it is
# never one file of two.
if [[ ${#reads[@]} -eq 2 && ( ${formats[0]} == "$FORMAT_BAM" || ${formats[1]} == "$FORMAT_BAM" ) ]]; then
    die "a BAM holds both mates; pass it on its own"
fi

if [[ ${formats[0]} == "$FORMAT_BAM" ]]; then
    if names_references "${reads[0]}"; then
        die "${reads[0]} is already aligned; count it with cmuts hmm"
    fi

    if holds_pairs "${reads[0]}"; then
        die "${reads[0]} holds paired reads; write each mate to a FASTQ first"
    fi
fi

[[ ! -d $output ]] || die "$output is a directory; -o names the file to write"

if [[ -e $output && $overwrite != true ]]; then
    die "$output exists; pass --overwrite to replace it"
fi

directory=$(dirname "$output")
[[ -d $directory ]] || die "$directory is not a directory"

# Sorted into place beside the output and renamed upon completion
partial="$output.partial.$$"

# @SQ lines from minimap2 carry SN and LN only. samtools dict computes each
# reference's M5, which the awk pass splices in by name.
dict="$output.dict.$$"

trap 'rm -f "$partial" "$dict"' EXIT

samtools dict "$fasta" > "$dict"

# Merges each pair of mates into one consensus read, so that their overlap
# counts a molecule once; cmuts-hmm refuses an unmerged pair for that reason.
# A pair fastp cannot merge is discarded, and its reports are not kept.
merge() {
    fastp --merge --stdout \
        --in1 "${reads[0]}" --in2 "${reads[1]}" \
        --thread "$(( threads < MERGE_THREADS_MAX ? threads : MERGE_THREADS_MAX ))" \
        --json /dev/null --html /dev/null
}

# Reads a BAM's records back as FASTQ, which is what minimap2 accepts.
unpack() {
    samtools fastq -@ "$threads" "${reads[0]}"
}

map() {
    minimap2 -a -x "$preset" --secondary=no -t "$threads" "$fasta" "$@"
}

align() {
    if [[ ${#reads[@]} -eq 2 ]]; then
        merge | map -
    elif [[ ${formats[0]} == "$FORMAT_BAM" ]]; then
        unpack | map -
    else
        map "${reads[@]}"
    fi
}

align \
    | awk -v limit="$NAME_LIMIT" -v dict="$dict" '
        BEGIN {
            FS = OFS = "\t"
            while ((getline line < dict) > 0) {
                n = split(line, field, FS)
                name = ""
                sum  = ""
                for (i = 2; i <= n; i++) {
                    if (field[i] ~ /^SN:/) { name = substr(field[i], 4) }
                    if (field[i] ~ /^M5:/) { sum  = substr(field[i], 4) }
                }
                if (name != "" && sum != "") { m5[name] = sum }
            }
        }
        /^@SQ/ {
            name = ""
            for (i = 2; i <= NF; i++) {
                if ($i ~ /^SN:/) { name = substr($i, 4) }
            }
            if (name in m5) { $0 = $0 OFS "M5:" m5[name] }
            print; next
        }
        /^@/  { print; next }
              { if (length($1) > limit) { $1 = substr($1, 1, limit) } print }' \
    | samtools sort -@ "$threads" -o "$partial" -

mv "$partial" "$output"
