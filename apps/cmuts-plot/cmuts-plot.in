#!/usr/bin/env python3
"""cmuts-plot -- serve an interactive HTML report over cmuts outputs.

Each input file is one condition. One chip row at the top of the page selects
the condition every figure and every statistic is shown for, so the page holds
one condition at a time. Each condition carries its own checked event channels,
which the reactivity profile is summed over. The files need not hold the same
library: comparisons are by reference index and position, so a one-off
construct can sit beside a large library, or a mutant beside its wild type.

The multi-plot and the difference plot are where conditions meet. Each of
their rows names its own condition, and is drawn from the channels that
condition carries.

The server holds the files and builds every figure on demand. The browser
fetches every condition's figure for the view in front of it into JSON stores
inside the page, and draws only from those stores. Saving the page keeps the
stores, so a snapshot stays interactive offline: the condition chips still
switch, while the reference dropdown and the channel boxes need the server.

The file reads top-down in layers: reading the files, the array transforms,
the figure builders, the figure registry, the statistics, the page shell, and
the server. A new figure is one builder, one Plot entry, and its place in a
section list.

Author: Hamish M. Blair <hmblair@stanford.edu>
"""

import argparse
import json
import sys
from dataclasses import dataclass
from datetime import datetime
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

VERSION = "@VERSION@"

try:
    import h5py
    import numpy as np
    import plotly.colors as pc
    import plotly.graph_objects as go
    from plotly.offline import get_plotlyjs
except ImportError as error:
    print(f"cmuts-plot: {error.name}: not installed; "
          "cmuts plot needs the h5py, numpy, and plotly packages", file=sys.stderr)
    sys.exit(1)


# ===========================================================================
# The file format, as include/format.h names it
# ===========================================================================

COVERAGE = "coverage"
SEQUENCE = "sequence"
PRIMARY_COUNTED = "reads/primary/counted"
PRIMARY_REJECTED = "reads/primary/rejected"
SUPPLEMENTARY_COUNTED = "reads/supplementary/counted"
SUPPLEMENTARY_REJECTED = "reads/supplementary/rejected"
LENGTHS = "reads/lengths"
UNMAPPED = "reads/unmapped"
PAIRWISE_CORRELATION = "pairwise/correlation"
PAIRWISE_CONDITIONAL = "pairwise/conditional"
PAIRWISE_COVERAGE = "pairwise/coverage"

# The event channels, each a group holding a rate and its error. The labels
# are what the page's checkboxes say.
CHANNELS = ("mismatches", "insertions", "deletions", "terminations")
CHANNEL_LABELS = {
    "mismatches": "Substitutions",
    "insertions": "Insertions",
    "deletions": "Deletions",
    "terminations": "Terminations",
}

# The channels the reactivity is summed over when the page opens. A read which
# stops at a base has not modified it. The termination channel is therefore
# unchecked at the start, and its checkbox turns it on.
DEFAULT_CHANNELS = ("mismatches", "insertions", "deletions")

# The named channel sets the page offers as chips. A chip checks exactly its
# channels, and is active while exactly those channels are checked.
CHANNEL_PRESETS = {
    "DMS": ("mismatches",),
    "SHAPE": ("mismatches", "deletions"),
}

# The character of each token of the sequence dataset, indexed by the token: the four
# named bases, then the token for any other base. A negative token is padding. This must
# match NUC_TOKEN_CHARS in include/nuc.h, which spells token 3 as T.
BASES = "ACGUN"

# The data-ref value meaning "aggregate over all references".
AGGREGATE_REF = "agg"


def rate_name(channel):
    return f"{channel}/rate"


def error_name(channel):
    return f"{channel}/error"


# ===========================================================================
# Reading the files
# ===========================================================================


@dataclass(frozen=True)
class Condition:
    """One input file: a label for the chips and the path holding the data."""

    label: str
    path: str


def dataset(handle, name):
    """Returns one dataset as an array, or None if the file does not have
    it."""
    if name not in handle:
        return None

    return np.asarray(handle[name])


def file_shape(handle):
    """Returns the reference count and the row width, taken from the
    coverage dataset that every output has."""
    n_refs, cap = handle[COVERAGE].shape
    return int(n_refs), int(cap)


def check_conditions(conditions):
    """Refuses an input that is not a cmuts output. Such a file either does
    not open, or has no coverage dataset."""
    for condition in conditions:
        try:
            with h5py.File(condition.path, "r") as handle:
                file_shape(handle)
        except (OSError, KeyError) as error:
            return f"{condition.path}: {error}"

    return None


def condition_refs(conditions):
    """Returns the reference count of each condition, in order."""
    counts = []

    for condition in conditions:
        with h5py.File(condition.path, "r") as handle:
            counts.append(file_shape(handle)[0])

    return counts


def decode_sequence(handle, ref):
    """Returns one reference's bases without the padding, or None if the
    file has no sequence."""
    tokens = dataset(handle, SEQUENCE)

    if tokens is None:
        return None

    row = tokens[ref]
    held = row[row >= 0]

    return "".join(BASES[token] for token in held)


# ===========================================================================
# Transforms: numpy in, numpy out
# ===========================================================================


def summed_rate(rates):
    """Returns the sum of the rates of the given channels. The sum is NaN
    wherever any channel is NaN."""
    total = np.zeros_like(rates[0], dtype=np.float32)

    for rate in rates:
        total = total + rate

    return total


def summed_error(errors):
    """Returns the error of the sum, which adds the errors of the channels
    in quadrature."""
    total = np.zeros_like(errors[0], dtype=np.float32)

    for error in errors:
        total = total + error * error

    return np.sqrt(total)


def reactivity_of(handle, channels, ref=None):
    """Returns the summed rate and error over the selected channels, for one
    reference or for every reference at once. Returns None if the file
    has none of the selected rates. A missing error counts as zero."""
    rows = slice(None) if ref is None else ref
    rates, errors = [], []

    for channel in channels:
        if rate_name(channel) not in handle:
            return None, None

        rates.append(np.asarray(handle[rate_name(channel)][rows], dtype=np.float32))

        if error_name(channel) in handle:
            errors.append(np.asarray(handle[error_name(channel)][rows], dtype=np.float32))
        else:
            errors.append(np.zeros_like(rates[-1]))

    if not rates:
        return None, None

    return summed_rate(rates), summed_error(errors)


def mean_of(values):
    """Returns the mean as a float, or NaN if there is nothing to average."""
    values = np.asarray(values, dtype=float)

    if values.size == 0:
        return float("nan")

    return float(values.mean())


def snr_of(reactivity, error):
    """Returns the signal-to-noise ratio at each base, which is the
    reactivity over the error. The result is zero where the error is
    zero, and NaN where the reactivity is NaN."""
    r = np.asarray(reactivity, dtype=float)
    e = np.asarray(error, dtype=float)
    out = np.zeros_like(r)

    np.divide(r, e, where=(e > 0), out=out)
    out[~np.isfinite(r)] = np.nan

    return out


def read_log_depth(reads):
    """Returns the log10 read depth of each reference. A reference with no
    reads maps to -1."""
    reads = np.asarray(reads, dtype=float)

    with np.errstate(divide="ignore"):
        return np.where(reads == 0, -1, np.log10(reads))


def read_histogram(reads, bins=100):
    """Returns a histogram of the log10 read depth: the bin centers, the
    counts, and the counts rescaled to [0, 1] so that each bar can be
    colored."""
    counts, edges = np.histogram(read_log_depth(reads), bins=bins)
    centers = (edges[:-1] + edges[1:]) / 2
    low, high = float(counts.min()), float(counts.max())

    if high == low:
        return centers, counts, np.zeros_like(counts, dtype=float)

    return centers, counts, (counts - low) / (high - low)


def reads_per_block(reads, nblocks=100):
    """Returns the mean reads per reference over nblocks equal blocks, in
    file order, so that a trend across the library stays visible."""
    reads = np.asarray(reads, dtype=float)
    nblocks = max(min(nblocks, reads.shape[0]), 1)
    block = max(reads.shape[0] // nblocks, 1)
    reads = reads[: nblocks * block]

    return reads.reshape(nblocks, block).mean(1)


def length_distribution(lengths):
    """Returns the read-length counts, trimmed to the longest length seen.
    Bin i holds length i + 1. A two-dimensional input is summed over
    references first."""
    counts = np.asarray(lengths, dtype=float)

    if counts.ndim == 2:
        counts = counts.sum(0)

    held = np.nonzero(counts)[0]
    end = 1

    if held.size:
        end = int(held[-1]) + 1

    return np.arange(1, end + 1), counts[:end]


def symlog(values, linthresh):
    """Returns the symmetric log of the values, which is sign(x) * log10(1 +
    |x| / linthresh)."""
    values = np.asarray(values)

    return np.sign(values) * np.log10(1.0 + np.abs(values) / linthresh)


# ===========================================================================
# Figure styling
# ===========================================================================

FONT_FAMILY = "Arial, sans-serif"
LABEL_SIZE = 14
TITLE_SIZE = 15
TICK_SIZE = 13
LEGEND_SIZE = 12

MARGIN = {"l": 55, "r": 20, "t": 40, "b": 45}

RDPU_FILL = pc.sample_colorscale("RdPu", [0.3])[0]
RDPU_LINE = pc.sample_colorscale("RdPu", [0.8])[0]

PROFILE_COLOR = "#c51b8a"

# The coverage plot marks the primary read count with this line style.
READS_LINE_COLOR = "black"
READS_LINE_DASH = "dot"
OVERLAY_COLORS = ["#c51b8a", "#2c7fb8", "#31a354", "#e6550d", "#756bb1", "#636363"]

# Correlation heatmaps use a symmetric-log color scale around zero.
CORRELATION_LINTHRESH = 1e-3


def rgba(rgb, alpha):
    return rgb.replace("rgb(", "rgba(").replace(")", f", {alpha})")


def hex_rgba(hex_color, alpha):
    h = hex_color.lstrip("#")
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)

    return f"rgba({r}, {g}, {b}, {alpha})"


def base_layout(title, xlabel="", ylabel=""):
    return {
        "font": {"family": FONT_FAMILY},
        "title": {"text": title, "font": {"size": TITLE_SIZE}},
        "xaxis": {
            "title": {"text": xlabel, "font": {"size": LABEL_SIZE}},
            "tickfont": {"size": TICK_SIZE},
        },
        "yaxis": {
            "title": {"text": ylabel, "font": {"size": LABEL_SIZE}},
            "tickfont": {"size": TICK_SIZE},
            "gridcolor": "rgba(0,0,0,0.15)",
        },
        "plot_bgcolor": "white",
        "legend": {"font": {"size": LEGEND_SIZE}},
        "margin": MARGIN,
    }


def line_layout(xlabel, ylabel):
    """Returns the layout of the reactivity line plots. It has a left spine
    with outside ticks, the zero baseline as its only horizontal line,
    and a boxed legend."""
    grid = "rgba(0,0,0,0.08)"
    ink = "#444"

    return {
        "font": {"family": FONT_FAMILY},
        "xaxis": {
            "title": {"text": xlabel, "font": {"size": 16}, "standoff": 14},
            "tickfont": {"size": TICK_SIZE},
            "showline": False,
            "zeroline": False,
            "ticks": "",
            "gridcolor": grid,
        },
        "yaxis": {
            "title": {"text": ylabel, "font": {"size": 16}, "standoff": 14},
            "tickfont": {"size": TICK_SIZE},
            "ticks": "outside",
            "ticklen": 6,
            "tickcolor": ink,
            "tickwidth": 1,
            "showline": True,
            "linecolor": ink,
            "linewidth": 1,
            "zeroline": True,
            "zerolinecolor": ink,
            "zerolinewidth": 1,
            "gridcolor": grid,
        },
        "plot_bgcolor": "white",
        "legend": {
            "bgcolor": "rgba(255,255,255,0.9)",
            "bordercolor": "#ccc",
            "borderwidth": 1,
            "font": {"size": TICK_SIZE},
            "x": 0.99,
            "xanchor": "right",
            "y": 0.99,
            "yanchor": "top",
        },
        "margin": {"l": 72, "r": 24, "t": 28, "b": 62},
    }


def colorbar(title, **extra):
    """Returns an outlined colorbar with outside ticks and a rotated title."""
    bar = {
        "title": {"text": title, "side": "right", "font": {"size": LABEL_SIZE}},
        "outlinecolor": "black",
        "outlinewidth": 1,
        "ticks": "outside",
        "ticklen": 5,
        "tickcolor": "black",
        "tickfont": {"size": TICK_SIZE},
        "thickness": 15,
    }
    bar.update(extra)

    return bar


# ===========================================================================
# Figure builders: arrays in, go.Figure out
# ===========================================================================


def line_figure(data, xlabel, ylabel, x=None, yrange=None, axis_lines=False):
    """Returns a single line plot filled to zero, which is the shape the
    coverage and length plots share."""
    data = np.asarray(data)

    if x is None:
        x = np.arange(data.shape[0])
    fig = go.Figure(
        go.Scatter(
            x=x,
            y=data,
            fill="tozeroy",
            fillcolor=rgba(RDPU_FILL, 0.5),
            line={"color": RDPU_LINE, "width": 1},
            showlegend=False,
        )
    )
    fig.update_layout(**base_layout("", xlabel, ylabel))
    spine = {}

    if axis_lines:
        spine = {"showline": True, "linecolor": "black", "linewidth": 1}

    fig.update_xaxes(range=[np.asarray(x)[0], np.asarray(x)[-1]], **spine)

    if yrange is not None:
        fig.update_yaxes(range=yrange, **spine)
    elif spine:
        fig.update_yaxes(**spine)

    return fig


def profile_traces(reactivity, error, name, color, show_band_legend=False):
    """Returns a reactivity line and its standard-error band. The band is
    one closed polygon per run of defined points, so it breaks at NaN
    gaps instead of filling straight across them."""
    react = np.asarray(reactivity, dtype=float)
    n = react.shape[0]
    x = np.arange(n)
    traces = []

    if error is not None:
        err = np.asarray(error, dtype=float)
        upper, lower = react + err, react - err
        defined = np.isfinite(react)
        band_shown = False
        i = 0

        while i < n:
            if not defined[i]:
                i += 1
                continue

            start = i
            while i < n and defined[i]:
                i += 1

            traces.append(
                go.Scatter(
                    x=[*x[start:i], *x[start:i][::-1]],
                    y=[*upper[start:i], *lower[start:i][::-1]],
                    fill="toself",
                    fillcolor=hex_rgba(color, 0.2),
                    line={"width": 0},
                    mode="lines",
                    name="Std. error",
                    showlegend=show_band_legend and not band_shown,
                    hoverinfo="skip",
                )
            )
            band_shown = True

    traces.append(
        go.Scatter(x=x, y=react, mode="lines",
                   line={"color": color, "width": 1.5}, name=name)
    )

    return traces


def plot_profile(reactivity, error):
    """Returns one reference's reactivity as a line with its standard-error
    band."""
    fig = go.Figure()

    for trace in profile_traces(reactivity, error, "Reactivity", PROFILE_COLOR, True):
        fig.add_trace(trace)

    fig.update_layout(**line_layout("Residue", "Reactivity"))
    fig.update_layout(showlegend=True, legend={"traceorder": "reversed"})

    return fig


def plot_overlay(series):
    """Returns several reactivity profiles drawn over each other. Each
    series has a reactivity, an optional error, and its legend label."""
    fig = go.Figure()

    for i, s in enumerate(series):
        color = OVERLAY_COLORS[i % len(OVERLAY_COLORS)]
        for trace in profile_traces(s["reactivity"], s.get("error"), s["label"], color):
            fig.add_trace(trace)

    fig.update_layout(**line_layout("Residue", "Reactivity"))
    fig.update_layout(showlegend=True)

    return fig


def plot_difference(a, b):
    """Returns the difference a - b of two profiles, with the errors
    propagated in quadrature."""
    ra = np.asarray(a["reactivity"], dtype=float)
    rb = np.asarray(b["reactivity"], dtype=float)
    n = min(ra.shape[0], rb.shape[0])
    ea = np.asarray(a["error"], dtype=float)[:n]
    eb = np.asarray(b["error"], dtype=float)[:n]

    diff = ra[:n] - rb[:n]
    err = np.sqrt(ea**2 + eb**2)

    fig = go.Figure()
    for trace in profile_traces(diff, err, f"{a['label']} − {b['label']}", PROFILE_COLOR):
        fig.add_trace(trace)

    fig.update_layout(**line_layout("Residue", "Reactivity Difference"))
    fig.update_layout(showlegend=False)

    return fig


def plot_coverage(coverage, reads):
    """Returns a coverage profile. A dotted line marks the number of primary
    reads over the references that the profile includes."""
    fig = line_figure(coverage, "Residue", "Coverage", axis_lines=True)

    if reads is not None and reads > 0:
        fig.add_hline(y=reads, line_dash=READS_LINE_DASH, line_width=1,
                      line_color=READS_LINE_COLOR)

    return fig


def plot_read_hist(reads):
    centers, counts, normalized = read_histogram(reads)
    colors = [pc.sample_colorscale("RdPu", [float(v)])[0] for v in normalized]

    fig = go.Figure(go.Bar(x=centers, y=counts, marker_color=colors, showlegend=False))
    fig.update_layout(**base_layout("", "log10 Read Depth", "Count"))
    fig.update_layout(bargap=0)

    return fig


def plot_reads_per_block(reads):
    return line_figure(reads_per_block(reads), "Reference bin", "Mean reads")


def plot_lengths(lengths):
    x, counts = length_distribution(lengths)

    return line_figure(counts, "Read length", "Reads", x=x)


def plot_reactivity_heatmap(reactivity, num=250):
    """Returns every reference's reactivity as a heatmap of reference
    against position, clipped to the first num references so that it
    stays bounded. A NaN position is colored grey through a sentinel just
    below zero."""
    sentinel = -0.01
    data = np.asarray(reactivity)[:num].copy()
    data[np.isnan(data)] = sentinel

    eps = 0.001
    colorscale = [
        [0.0, "grey"],
        [eps, "grey"],
        [eps + 0.001, pc.sample_colorscale("RdPu", [0.0])[0]],
        [1.0, pc.sample_colorscale("RdPu", [1.0])[0]],
    ]

    fig = go.Figure(
        go.Heatmap(z=data, colorscale=colorscale, zmin=sentinel, zmax=1,
                   colorbar=colorbar("Reactivity"))
    )
    fig.update_layout(**base_layout("", "Residue", "Sequence Index"))
    fig.update_layout(yaxis_autorange="reversed")

    return fig


def matrix_heatmap(z, colorscale, zmin, zmax, bar):
    """Returns an L x L matrix as a square heatmap with the y axis reversed.
    scaleanchor keeps the cells square inside the wider card, so the
    full-height colorbar matches the plot exactly."""
    fig = go.Figure(
        go.Heatmap(z=z, colorscale=colorscale, zmin=zmin, zmax=zmax, colorbar=bar)
    )
    fig.update_layout(**base_layout("", "Residue", "Residue"))
    fig.update_layout(
        yaxis_autorange="reversed",
        yaxis_scaleanchor="x",
        xaxis_constrain="domain",
        yaxis_constrain="domain",
    )

    return fig


def plot_correlation(values):
    z = symlog(values, CORRELATION_LINTHRESH)
    top = float(symlog(np.array([1.0]), CORRELATION_LINTHRESH)[0])
    ticks = [-1, -0.1, -0.01, 0, 0.01, 0.1, 1]
    bar = colorbar(
        "Pairwise Correlation",
        tickvals=[float(symlog(np.array([v]), CORRELATION_LINTHRESH)[0]) for v in ticks],
        ticktext=[str(v) for v in ticks],
    )

    return matrix_heatmap(z, "PiYG", -top, top, bar)


def plot_conditional(values):
    return matrix_heatmap(np.asarray(values), "RdPu", 0, 1,
                          colorbar("Conditional Probability"))


def plot_pairwise_coverage(values):
    low = max(float(np.nanmin(values)), 1e-4)

    with np.errstate(divide="ignore", invalid="ignore"):
        z = np.log10(np.clip(values, low, None))

    return matrix_heatmap(z, "RdPu", np.log10(low), float(np.nanmax(z)),
                          colorbar("Pairwise Coverage"))


# ===========================================================================
# The figure registry: what the report can show
# ===========================================================================


@dataclass(frozen=True)
class Plot:
    """One report figure. render(handle, ref, channels) returns the figure
    for one reference, where ref is an index, or for the aggregate, where
    ref is None. It returns None if the file lacks the data, or if the
    plot has no such view."""

    key: str
    label: str
    aspect: str  # "std" | "wide" | "square"
    render: object


def render_profile(handle, ref, channels):
    if ref is None:
        return None

    reactivity, error = reactivity_of(handle, channels, ref)

    if reactivity is None:
        return None

    return plot_profile(reactivity, error)


def render_heatmap(handle, ref, channels):
    if ref is not None:
        return None

    reactivity, _ = reactivity_of(handle, channels)

    if reactivity is None:
        return None

    return plot_reactivity_heatmap(reactivity)


def render_coverage(handle, ref, channels):
    coverage = dataset(handle, COVERAGE)
    reads = dataset(handle, PRIMARY_COUNTED)

    if coverage is None:
        return None

    if ref is None:
        return plot_coverage(coverage.sum(0),
                             None if reads is None else float(reads.sum()))

    return plot_coverage(coverage[ref],
                         None if reads is None else float(reads[ref]))


def render_reads(handle, ref, channels):
    reads = dataset(handle, PRIMARY_COUNTED)

    if ref is not None or reads is None:
        return None

    return plot_read_hist(reads)


def render_reads_per_block(handle, ref, channels):
    reads = dataset(handle, PRIMARY_COUNTED)

    if ref is not None or reads is None:
        return None

    return plot_reads_per_block(reads)


def render_lengths(handle, ref, channels):
    lengths = dataset(handle, LENGTHS)

    if lengths is None:
        return None

    if ref is not None:
        lengths = lengths[ref]

    return plot_lengths(lengths)


def render_pairwise(name, build):
    """Returns a builder for one of the pairwise matrices. These exist per
    reference, and only where the run asked for them."""
    def render(handle, ref, channels):
        if ref is None or name not in handle:
            return None

        return build(np.asarray(handle[name][ref]))

    return render


PROFILE_PLOT = Plot("profile", "Reactivity profile", "wide", render_profile)
HEATMAP_PLOT = Plot("heatmap", "Reactivity heatmap", "wide", render_heatmap)
COVERAGE_PLOT = Plot("coverage", "Coverage", "std", render_coverage)
READS_PLOT = Plot("reads", "Reads per reference", "std", render_reads)
BLOCKS_PLOT = Plot("reads-per-block", "Reads per block", "std", render_reads_per_block)
LENGTHS_PLOT = Plot("lengths", "Read lengths", "std", render_lengths)
CORRELATION_PLOT = Plot("correlation", "Pairwise correlation", "square",
                        render_pairwise(PAIRWISE_CORRELATION, plot_correlation))
CONDITIONAL_PLOT = Plot("conditional", "Pairwise conditional", "square",
                        render_pairwise(PAIRWISE_CONDITIONAL, plot_conditional))
PAIRCOV_PLOT = Plot("pairwise-coverage", "Pairwise coverage", "square",
                    render_pairwise(PAIRWISE_COVERAGE, plot_pairwise_coverage))

REGISTRY = {p.key: p for p in (
    PROFILE_PLOT, HEATMAP_PLOT, COVERAGE_PLOT, READS_PLOT, BLOCKS_PLOT, LENGTHS_PLOT,
    CORRELATION_PLOT, CONDITIONAL_PLOT, PAIRCOV_PLOT,
)}

# Section membership: what a single-reference report shows, what the
# aggregate view of a multi-reference report shows, and what its
# per-sequence view shows. A new figure joins the lists it belongs in.
SINGLE = (PROFILE_PLOT, COVERAGE_PLOT, LENGTHS_PLOT,
          CORRELATION_PLOT, CONDITIONAL_PLOT, PAIRCOV_PLOT)
AGGREGATE = (HEATMAP_PLOT, COVERAGE_PLOT, READS_PLOT, BLOCKS_PLOT, LENGTHS_PLOT)
PER_SEQ = (PROFILE_PLOT, COVERAGE_PLOT, LENGTHS_PLOT,
           CORRELATION_PLOT, CONDITIONAL_PLOT, PAIRCOV_PLOT)

# The figure kinds composed client-side rather than tagged on a card.
OVERLAY = "overlay"
DIFFERENCE = "difference"


def parse_ref(value):
    """Returns the index a reference selector names, or None for the
    aggregate view."""
    if value is None or value == "" or value == AGGREGATE_REF:
        return None

    return int(value)


def parse_channels(value):
    """Returns the checked channels, in canonical order."""
    if value is None:
        value = list(DEFAULT_CHANNELS)

    return [c for c in CHANNELS if c in value]


def parse_channel_map(value, conditions):
    """Returns the checked channels of every condition, keyed by label. A
    condition the request leaves out falls back to the default channels."""
    value = value or {}

    return {c.label: parse_channels(value.get(c.label)) for c in conditions}


def default_channel_map(conditions):
    return {c.label: list(DEFAULT_CHANNELS) for c in conditions}


def condition_path(conditions, label):
    for condition in conditions:
        if condition.label == label:
            return condition.path

    raise KeyError(f"no condition labeled {label}")


def series_of(conditions, spec):
    """Returns one overlay or difference series, which is the summed
    reactivity of the selected condition at one reference, over the
    channels of that condition, with its legend label. Returns None if
    the reference lies past the library of this condition."""
    ref = int(spec.get("ref", 0) or 0)
    channels = parse_channels(spec.get("channels"))

    with h5py.File(condition_path(conditions, spec["cond"]), "r") as handle:
        if ref >= file_shape(handle)[0]:
            return None

        reactivity, error = reactivity_of(handle, channels, ref)

    if reactivity is None:
        return None

    return {"reactivity": reactivity, "error": error, "label": spec.get("label", "")}


def render_figure(conditions, spec):
    """Returns the requested figure, or None if the kind is unknown or the
    data is absent. spec gives the kind and the coordinates: cond, ref
    and channels for a card figure, series for an overlay, and a and b
    for a difference. Each series names the channels of its own
    condition."""
    kind = spec["kind"]

    if kind == OVERLAY:
        series = [series_of(conditions, s) for s in spec["series"]]

        return plot_overlay([s for s in series if s is not None])

    if kind == DIFFERENCE:
        a = series_of(conditions, spec["a"])
        b = series_of(conditions, spec["b"])

        if a is None or b is None:
            return None

        return plot_difference(a, b)

    plot = REGISTRY.get(kind)

    if plot is None:
        return None

    with h5py.File(condition_path(conditions, spec["cond"]), "r") as handle:
        ref = parse_ref(spec.get("ref"))

        if ref is not None and ref >= file_shape(handle)[0]:
            return None

        return plot.render(handle, ref, parse_channels(spec.get("channels")))


# ===========================================================================
# Summary statistics
# ===========================================================================

# The boxes the read tiles are laid out in.
PRIMARY_GROUP = "Primary Reads"
SUPPLEMENTARY_GROUP = "Supplementary Reads"

# The thresholds the library view reports the SNR against.
SNR_THRESHOLDS = (1, 10)


@dataclass(frozen=True)
class Stat:
    """One tile: a label, a value, how to format it, and the group box it
    belongs to."""

    label: str
    value: float
    fmt: str = "float"
    prec: int = 2
    group: str = ""


def library_stats(handle, ref):
    """Returns the Library group: the reference count on the aggregate view,
    and the length of the reference in view, read from its sequence. A
    condition with one reference has both on the one view."""
    n_refs, _ = file_shape(handle)
    rows = []

    if ref is None:
        rows.append(Stat("References", n_refs, "int", group="Library"))

    if ref is not None or n_refs == 1:
        bases = decode_sequence(handle, ref or 0)

        if bases is not None:
            rows.append(Stat("Reference length", len(bases), "int", group="Library"))

    return rows


def count_stats(values, name, group, ref, n_refs):
    """Returns the tiles for one count: its value at the reference in view, or
    its total, mean and median over the library where no reference is in
    view."""
    values = np.asarray(values, dtype=float)

    if ref is not None or n_refs == 1:
        return [Stat(name, float(values[ref or 0]), "int", group=group)]

    return [
        Stat(f"{name} (Total)", float(values.sum()), "int", group=group),
        Stat(f"{name} (Mean)", float(values.mean()), "float", group=group),
        Stat(f"{name} (Median)", float(np.median(values)), "int", group=group),
    ]


def kind_read_stats(handle, ref, counted, rejected, group):
    """Returns the tiles of one kind of alignment record: the records counted at
    the reference in view and the records rejected there, or their statistics
    over the library where no reference is in view."""
    n_refs, _ = file_shape(handle)
    stats = []

    for name, field in (("Counted", counted), ("Rejected", rejected)):
        values = dataset(handle, field)

        if values is None:
            continue

        stats += count_stats(values, name, group, ref, n_refs)

    return stats


def unmapped_read_stats(handle, ref):
    """Returns the reads the aligner placed on no reference, which the library
    view alone shows because they belong to no reference."""
    unmapped = dataset(handle, UNMAPPED)

    if ref is not None or unmapped is None:
        return []

    return [Stat("Unmapped", float(unmapped), "int", group=PRIMARY_GROUP)]


def read_stats(handle, ref):
    """Returns the two read groups: the primary reads counted, rejected and
    unmapped, and the supplementary reads counted and rejected."""
    primary = kind_read_stats(handle, ref, PRIMARY_COUNTED, PRIMARY_REJECTED,
                              PRIMARY_GROUP)
    supplementary = kind_read_stats(handle, ref, SUPPLEMENTARY_COUNTED,
                                    SUPPLEMENTARY_REJECTED, SUPPLEMENTARY_GROUP)

    return primary + unmapped_read_stats(handle, ref) + supplementary


def reactivity_stats(handle, channels, ref):
    """Returns the Reactivity and SNR groups, over the sum of the selected
    channels."""
    n_refs, _ = file_shape(handle)
    reactivity, error = reactivity_of(handle, channels, ref)

    if reactivity is None:
        return []

    held = np.isfinite(reactivity)
    snr = snr_of(reactivity, error)
    finite = snr[np.isfinite(snr)]

    rows = [
        Stat("Mean reactivity", mean_of(reactivity[held]), "float", 3, group="Reactivity"),
        Stat("Mean error", mean_of(error[held]), "float", 3, group="Reactivity"),
        Stat("Mean SNR", mean_of(finite), "float", group="SNR"),
    ]

    if ref is None and n_refs > 1:
        rows += [Stat(f"SNR > {threshold}", mean_of(finite > threshold), "float",
                      group="SNR")
                 for threshold in SNR_THRESHOLDS]

    return rows


def condition_stats(handle, channels, ref):
    return (library_stats(handle, ref) + read_stats(handle, ref)
            + reactivity_stats(handle, channels, ref))


# ===========================================================================
# The page shell: pure HTML builders
# ===========================================================================


def escape(text):
    """Escapes a label for HTML text and attribute positions."""
    return (str(text).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def fmt_stat(stat):
    """Returns one tile's value as text. It gives an em dash where the value
    is not finite, and scientific notation where the fixed precision
    would round it to zero."""
    if not np.isfinite(stat.value):
        return "—"
    if stat.fmt == "int":
        return f"{int(stat.value):,}"
    if 0 < abs(stat.value) < 10 ** -stat.prec:
        return f"{stat.value:.1e}"

    return f"{stat.value:.{stat.prec}f}"


def grouped_stats_html(stats):
    """Returns the tiles as labeled group boxes, in order of first
    appearance."""
    groups = {}

    for stat in stats:
        groups.setdefault(stat.group, []).append(stat)

    boxes = ""
    for name, members in groups.items():
        tiles = "".join(
            f'<div class="stat"><div class="stat-value">{fmt_stat(s)}</div>'
            f'<div class="stat-label">{s.label}</div></div>'
            for s in members
        )
        boxes += (f'<div class="stat-group"><div class="stat-group-label">{name}</div>'
                  f'<div class="stat-group-tiles">{tiles}</div></div>')

    return f'<div class="stat-groups">{boxes}</div>'


def active(label, default):
    return " active" if label == default else ""


def cond_toggle_html(labels):
    """Returns the chip row that selects the condition the whole page shows.
    The first condition starts active."""
    buttons = "".join(
        f'<button type="button" class="cond-btn{active(c, labels[0])}" '
        f'data-cond="{escape(c)}">{escape(c)}</button>'
        for c in labels
    )

    return f'<div class="cond-toggle">{buttons}</div>'


def condition_block_html(condition, channels, ref):
    """Returns one condition's grouped stats, or a note where the selected
    reference lies past the library of that condition."""
    with h5py.File(condition.path, "r") as handle:
        if ref is not None and ref >= file_shape(handle)[0]:
            return f'<p class="stat-note">No reference {ref + 1}.</p>'

        return grouped_stats_html(condition_stats(handle, channels, ref))


def stats_conditions_html(conditions, channel_map, ref):
    """Returns one block per condition, each over the channels of that
    condition, with the chip row at the top showing one of them. The
    /stats endpoint returns this same body, so the client can fetch it
    again when the checked channels or the reference change."""
    first = conditions[0].label
    blocks = ""

    for condition in conditions:
        blocks += (f'<div class="cond-stats{active(condition.label, first)}" '
                   f'data-cond="{escape(condition.label)}">'
                   f'{condition_block_html(condition, channel_map[condition.label], ref)}</div>')

    return f'<div class="stats-conditions">{blocks}</div>'


def channel_presets_html():
    """Returns one chip per named channel set."""
    buttons = "".join(
        f'<button type="button" class="preset-btn" '
        f'data-preset="{",".join(channels)}">{escape(name)}</button>'
        for name, channels in CHANNEL_PRESETS.items()
    )

    return f'<div class="preset-toggle">{buttons}</div>'


def channel_toggle_html():
    """Returns one checkbox per channel, then the chips that select a named
    set of them. The boxes show the channels of the condition the page
    shows, and the default channels start checked."""
    boxes = "".join(
        f'<label class="channel"><input type="checkbox" data-channel="{c}"'
        f'{" checked" if c in DEFAULT_CHANNELS else ""}>'
        f'{CHANNEL_LABELS[c]}</label>'
        for c in CHANNELS
    )

    return (f'<div class="channel-toggle">{boxes}'
            f'<span class="control-label">Presets:</span>'
            f'{channel_presets_html()}</div>')


def plot_card(plot, first_label, ref, extra_class=""):
    """Returns a collapsible figure card. It starts as an empty placeholder
    that the client fetches into, on the condition the chips start on."""
    cls = "plot-details wide" if plot.aspect == "wide" else "plot-details"
    inner_cls = ("plot " + extra_class).strip()
    div = (f'<div class="figure {plot.aspect}">'
           f'<div class="{inner_cls}" data-kind="{plot.key}" '
           f'data-cond="{escape(first_label)}" data-ref="{ref}"></div></div>')

    return f'<details class="{cls}"><summary>{plot.label}</summary>{div}</details>'


def plots_grid(cards):
    return '<div class="plots">' + "".join(cards) + "</div>"


def section(title, body):
    return f"<details><summary>{title}</summary>{body}</details>"


def seqview_html():
    return ('<div class="seqview-wrap"><div class="seqview-label">Sequence</div>'
            '<div class="seqview" id="seqview"></div></div>')


def reference_select_html(n_refs):
    options = "".join(f'<option value="{i}">Reference {i + 1}</option>'
                      for i in range(n_refs))

    return f'<select class="seqselect" id="refselect">{options}</select>'


def single_section(conditions, channel_map):
    first = conditions[0].label
    cards = [plot_card(plot, first, 0) for plot in SINGLE]

    return (f'<div id="stats-main">{stats_conditions_html(conditions, channel_map, None)}</div>'
            + seqview_html() + plots_grid(cards))


def aggregate_section(conditions, channel_map):
    first = conditions[0].label
    cards = [plot_card(plot, first, AGGREGATE_REF) for plot in AGGREGATE]

    return ("<h3>Aggregate data</h3>"
            + f'<div id="stats-main">{stats_conditions_html(conditions, channel_map, None)}</div>'
            + plots_grid(cards))


def per_sequence_section(conditions, channel_map, n_refs):
    first = conditions[0].label
    cards = [plot_card(plot, first, 0, "perseq-plot") for plot in PER_SEQ]

    return ("<h3>Per-sequence data</h3>"
            + reference_select_html(n_refs)
            + f'<div id="stats-perseq">{stats_conditions_html(conditions, channel_map, 0)}</div>'
            + seqview_html() + plots_grid(cards))


def comparison_sections():
    """Returns the shells of the multi-plot and of the difference plot. The
    client wires their rows."""
    return [
        section(
            "Multi-plot",
            '<div id="multiplot-rows"></div>'
            '<button id="multiplot-add">+ Add profile</button>'
            '<div class="figure wide"><div class="plot" id="multiplot"></div></div>',
        ),
        section(
            "Difference plot",
            '<div id="diff-rows"></div>'
            '<div class="figure wide"><div class="plot" id="diffplot"></div></div>',
        ),
    ]


def manifest_of(conditions, refs):
    """Returns the compact JSON the client reads: the condition labels, the
    reference count of each one, the channel vocabulary, and the channels
    every condition starts with."""
    return {
        "conditions": [c.label for c in conditions],
        "refs": refs,
        "channels": list(CHANNELS),
        "defaults": list(DEFAULT_CHANNELS),
        "kinds": {"profile": PROFILE_PLOT.key, "overlay": OVERLAY, "difference": DIFFERENCE},
    }


def embed_tags(manifest):
    return ('<script type="application/json" id="cmuts-manifest">'
            f"{json.dumps(manifest)}</script>\n")


def document(body, embed, n_conditions):
    plural = "s" if n_conditions != 1 else ""
    generated = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M %Z")
    subtitle = (f"{n_conditions} condition{plural} · generated on {generated}"
                f' by <span class="brand">cmuts v{VERSION}</span>')

    return (
        "<!doctype html>\n"
        '<html><head><meta charset="utf-8">'
        "<title>cmuts · Reactivity report</title>\n"
        f"<style>{CSS}</style>\n"
        f"<script>{get_plotlyjs()}</script>\n"
        "</head><body>\n"
        '<header class="report">'
        '<h1><span class="brand">cmuts</span> · Reactivity report</h1>'
        f'<p class="subtitle">{subtitle}</p>'
        '<p class="offline-note" hidden>Offline snapshot: the condition chips work; '
        "the reference and channel controls need the server.</p></header>\n"
        + body + "\n" + embed
        + f"<script>{REPORT_JS}</script>\n"
        "</body></html>\n"
    )


def control_row_html(label, control):
    """Returns one labeled row of the top bar."""
    return f'<span class="control-label">{label}</span>{control}'


def controls_html(labels):
    """Returns the top bar: the condition chips, then the channels of the
    condition they select. A report with one condition shows the channels
    alone."""
    rows = ""

    if len(labels) > 1:
        rows += control_row_html("Condition:", cond_toggle_html(labels))

    rows += control_row_html("Reactivity from:", channel_toggle_html())

    return f'<div class="controls">{rows}</div>'


def build_shell(conditions):
    """Returns the whole page: the top bar, the stats, the figure cards, and
    the comparison sections, with every figure fetched by the client. The
    single-reference layout applies only where every condition has one
    reference. Otherwise the dropdown reaches the largest library."""
    channel_map = default_channel_map(conditions)
    refs = condition_refs(conditions)
    n_refs = max(refs)

    parts = [controls_html([c.label for c in conditions])]

    if n_refs == 1:
        parts.append(single_section(conditions, channel_map))
    else:
        parts.append(aggregate_section(conditions, channel_map))
        parts.append(per_sequence_section(conditions, channel_map, n_refs))

    if len(conditions) > 1 or n_refs > 1:
        parts.extend(comparison_sections())

    embed = embed_tags(manifest_of(conditions, refs))

    return document("\n".join(parts), embed, len(conditions))


# ===========================================================================
# The page assets
# ===========================================================================

CSS = """
.plotly-notifier { display: none !important; }
:root {
  color-scheme: light dark;
  --bg: #ffffff; --surface: #f6f6f9; --ink: #1a1a1e; --muted: #6b6b76;
  --border: #e4e4ea; --accent: #c51b8a;
  --mono: ui-monospace, SFMono-Regular, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #14141a; --surface: #1e1e26; --ink: #ececf0; --muted: #9a9aa6;
          --border: #2c2c36; --accent: #e8479f; }
}
* { box-sizing: border-box; }
body { font-family: Arial, sans-serif;
       max-width: 1200px; margin: 0 auto; padding: 2rem 1.25rem 4rem; line-height: 1.5;
       color: var(--ink); background: var(--bg); }
header.report { border-bottom: 2px solid var(--accent); padding-bottom: 0.7rem; margin-bottom: 1.6rem; }
header.report h1 { font-size: 1.7rem; margin: 0; letter-spacing: -0.01em; }
header.report .subtitle { color: var(--muted); font-size: 0.9rem; margin: 0.3rem 0 0; }
.brand { font-family: var(--mono);
         font-size: 0.9em; padding: 0.08em 0.35em; border-radius: 5px;
         background: var(--surface); border: 1px solid var(--border); }
details { border: 1px solid var(--border); border-radius: 10px; margin: 1rem 0;
          padding: 0.3rem 1.1rem 1rem; background: var(--bg); }
details > summary { cursor: pointer; font-size: 1.15rem; font-weight: 650; padding: 0.6rem 0;
                    list-style: none; }
details > summary::-webkit-details-marker { display: none; }
details > summary::before { content: "\\25B8"; color: var(--accent); display: inline-block;
                            width: 1.1em; transition: transform 0.15s ease; }
details[open] > summary::before { transform: rotate(90deg); }
details.plot-details { border: none; border-radius: 0; background: transparent;
                       margin: 0; padding: 0; }
details.plot-details > summary { font-size: 1.05rem; font-weight: 600; color: var(--ink);
                                 padding: 0.5rem 0; }
.plots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
         gap: 0.1rem 1.2rem; align-items: start; grid-auto-flow: row dense; }
@media (max-width: 980px) { .plots { grid-template-columns: 1fr; } }
details.plot-details.wide { grid-column: 1 / -1; }
h3 { font-size: 1.05rem; font-weight: 650; color: var(--muted); text-transform: uppercase;
     letter-spacing: 0.05em; margin: 1.5rem 0 0.4rem; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
              gap: 0.6rem; margin: 0.9rem 0 1.3rem; }
.stat { background: var(--surface); border: 1px solid var(--border); border-radius: 9px;
        padding: 0.7rem 0.9rem; }
.stat-value { font-size: 1.45rem; font-weight: 600; line-height: 1.15; }
.stat-label { font-size: 0.78rem; color: var(--muted); margin-top: 0.25rem; }
.controls { display: grid; grid-template-columns: auto 1fr; align-items: center;
            justify-items: start; gap: 0.5rem 0.9rem; margin: 0.4rem 0 1rem;
            padding: 0.7rem 0.9rem; background: var(--surface);
            border: 1px solid var(--border); border-radius: 9px; }
.channel-toggle { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.control-label { font-size: 0.78rem; font-weight: 650; color: var(--muted);
                 text-transform: uppercase; letter-spacing: 0.05em; }
.channel { font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.35rem; }
.channel input { accent-color: var(--accent); }
.preset-toggle { display: inline-flex; border: 1px solid var(--border);
                 border-radius: 7px; overflow: hidden; }
.preset-btn { margin: 0; border: none; border-radius: 0; border-left: 1px solid var(--border);
              background: var(--bg); color: var(--muted); font-size: 0.82rem; padding: 4px 12px; }
.preset-btn:first-child { border-left: none; }
.preset-btn.active { background: var(--accent); color: #fff; }
.cond-toggle { display: inline-flex; border: 1px solid var(--border);
               border-radius: 7px; overflow: hidden; }
.cond-btn { margin: 0; border: none; border-radius: 0; border-left: 1px solid var(--border);
            background: var(--bg); color: var(--muted); font-size: 0.82rem; padding: 4px 12px; }
.cond-btn:first-child { border-left: none; }
.cond-btn.active { background: var(--accent); color: #fff; }
.figure { background: #ffffff; border: 1px solid #e6e6ec; border-radius: 10px;
          padding: 6px 10px; margin: 0.2rem 0 0.8rem; box-shadow: 0 1px 4px rgba(0,0,0,0.12); }
.figure.wide { aspect-ratio: 5 / 2; }
.figure.std { aspect-ratio: 3 / 2; }
.figure.square { aspect-ratio: 5 / 4; max-width: 760px; margin-inline: auto; }
.figure > *, .figure .plot { width: 100%; height: 100%; }
.plot { width: 100%; }
select, button { margin: 2px 6px 2px 0; padding: 5px 10px; font-size: 0.9rem; color: var(--ink);
                 background: var(--surface); border: 1px solid var(--border); border-radius: 6px; }
button { cursor: pointer; }
.row { margin: 5px 0; }
.seqview-wrap { margin: 4px 0 14px; }
.seqview-label { font-size: 0.78rem; font-weight: 600; color: var(--muted);
                 text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px; }
.seqview { font-family: var(--mono); font-size: 12px;
           line-height: 1.6; word-break: break-all; border: 1px solid #2c2c36;
           border-radius: 6px; padding: 6px 8px; background: #14141a; }
.seqview .base { display: inline-block; width: 1.15ch; text-align: center; font-weight: 600; }
#diff-rows { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
#diff-rows .row { margin: 0; }
#diff-rows select { margin: 0; }
.diff-op { color: var(--muted); }
.stat-groups { display: flex; flex-wrap: wrap; align-items: flex-start;
               gap: 0.8rem; margin: 0.5rem 0 1.3rem; }
.stat-group { border: 1px solid var(--border); border-radius: 10px;
              padding: 0.55rem 0.85rem 0.7rem; }
.stat-group-label { font-size: 0.72rem; font-weight: 650; color: var(--muted);
                    text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 0.55rem; }
.stat-group-tiles { display: flex; flex-wrap: wrap; gap: 0.35rem 1.2rem; }
.stat-group .stat { background: none; border: none; border-radius: 0; padding: 0; min-width: 76px; }
.stat-group .stat-value { font-size: 1.25rem; }
.stats-conditions { margin-bottom: 1.3rem; }
.stat-note { color: var(--muted); font-size: 0.85rem; margin: 0.6rem 0 1rem; }
.cond-stats { display: none; }
.cond-stats.active { display: block; }
.offline-note { color: var(--accent); font-size: 0.85rem; margin: 0.4rem 0 0; }
select:disabled, button:disabled, .cond-btn:disabled, .disabled {
  opacity: 0.45; cursor: not-allowed; pointer-events: none;
}
"""

REPORT_JS = """
(function () {
  // The shell fetches every condition's figure into JSON store nodes inside
  // each card, and every draw reads from those stores. On load it probes the
  // server; a reopened snapshot finds it gone, redraws from the saved stores,
  // and disables only the controls that need the server.
  var EXPORT = {wide: [1000, 400], std: [600, 400], square: [650, 520]};

  function readJSON(id) {
    var el = document.getElementById(id);
    return el ? JSON.parse(el.textContent) : null;
  }
  var MANIFEST = readJSON("cmuts-manifest") || {conditions: [], refs: [], channels: []};
  var CONDS = MANIFEST.conditions;
  var KINDS = MANIFEST.kinds || {};
  var REFS = MANIFEST.refs || [];
  var ONLINE = false;

  function refCountOf(cond) {
    return REFS[CONDS.indexOf(cond)] || 1;
  }

  // --- the channel checkboxes and the preset chips ---------------------------
  // Every condition carries its own channels. The boxes hold the channels of
  // the condition the chips select, and a store on the page keeps every
  // condition's set, so a saved page shows the channels its figures hold.
  var CHANNELS_BY_COND = {};
  function defaultChannels() {
    return (MANIFEST.defaults || []).slice();
  }
  function readChannelStores() {
    for (var i = 0; i < CONDS.length; i++) {
      CHANNELS_BY_COND[CONDS[i]] = readStore(document.body, "chanstore", CONDS[i])
                                || defaultChannels();
    }
  }
  function channelsOf(cond) {
    return CHANNELS_BY_COND[cond] || defaultChannels();
  }
  function setChannelsOf(cond, on) {
    CHANNELS_BY_COND[cond] = on;
    writeStore(document.body, "chanstore", cond, on);
  }
  function channelMap() {
    var map = {};
    for (var i = 0; i < CONDS.length; i++) map[CONDS[i]] = channelsOf(CONDS[i]);
    return map;
  }
  function checkedChannels() {
    var boxes = document.querySelectorAll(".channel-toggle input");
    var on = [];
    for (var i = 0; i < boxes.length; i++) {
      if (boxes[i].checked) on.push(boxes[i].getAttribute("data-channel"));
    }
    return on;
  }
  function checkChannels(on) {
    var boxes = document.querySelectorAll(".channel-toggle input");
    for (var i = 0; i < boxes.length; i++) {
      boxes[i].checked = on.indexOf(boxes[i].getAttribute("data-channel")) >= 0;
    }
  }
  function syncPresets() {
    var on = checkedChannels().sort().join(",");
    var chips = document.querySelectorAll(".preset-btn");
    for (var i = 0; i < chips.length; i++) {
      var want = chips[i].getAttribute("data-preset").split(",").sort();
      chips[i].classList.toggle("active", want.join(",") === on);
    }
  }
  function showChannels(cond) {
    checkChannels(channelsOf(cond));
    syncPresets();
  }
  // The channels of one condition changed, so only that condition's figures
  // are stale.
  function onChannelChange() {
    var cond = activeCond();
    setChannelsOf(cond, checkedChannels());
    syncPresets();
    refreshStats();
    renderCondition(cond).then(colorSeqview);
  }
  function bindChannelBoxes() {
    var boxes = document.querySelectorAll(".channel-toggle input");
    for (var i = 0; i < boxes.length; i++) {
      boxes[i].addEventListener("change", function () {
        if (checkedChannels().length === 0) { this.checked = true; return; }
        onChannelChange();
      });
    }
  }
  function bindChannelPresets() {
    var chips = document.querySelectorAll(".preset-btn");
    for (var i = 0; i < chips.length; i++) {
      chips[i].addEventListener("click", function () {
        checkChannels(this.getAttribute("data-preset").split(","));
        onChannelChange();
      });
    }
  }
  function bindChannels() {
    bindChannelBoxes();
    bindChannelPresets();
  }

  // --- figure fetch + render -------------------------------------------------
  // A card figure names one condition, so it is drawn from that condition's
  // channels. An overlay or difference carries them on each series instead.
  function fetchFigure(spec) {
    if (spec.cond) spec.channels = channelsOf(spec.cond);
    var url = "figure?spec=" + encodeURIComponent(JSON.stringify(spec));
    return fetch(url).then(function (r) { return r.ok ? r.json() : null; })
                     .catch(function () { return null; });
  }
  function specOf(div) {
    return {kind: div.getAttribute("data-kind"),
            cond: div.getAttribute("data-cond"),
            ref: div.getAttribute("data-ref")};
  }
  function figKind(div) {
    var fig = div.closest(".figure");
    if (fig && fig.classList.contains("wide")) return "wide";
    if (fig && fig.classList.contains("square")) return "square";
    return "std";
  }
  function slugify(s) {
    return String(s).replace(/[^A-Za-z0-9_-]+/g, "-").replace(/^-+|-+$/g, "") || "plot";
  }
  function figName(spec) {
    var parts = [spec.kind];
    if (spec.cond) parts.push(spec.cond);
    return parts.join("-");
  }
  function figConfig(kind, name) {
    var e = EXPORT[kind] || EXPORT.std;
    return {displaylogo: false, responsive: true,
            toImageButtonOptions: {format: "png", scale: 2, width: e[0], height: e[1],
                                   filename: slugify(name)}};
  }
  function drawInto(div, fig, kind, name) {
    // A snapshot's saved markup is not a live plot; clear it before the
    // first draw.
    if (!div._fullLayout) div.innerHTML = "";
    Plotly.react(div, fig.data, fig.layout, figConfig(kind, name));
  }
  function hideCard(div) {
    var card = div.closest("details.plot-details");
    if (card) card.style.display = "none";
  }
  function showCard(div) {
    var card = div.closest("details.plot-details");
    if (card) card.style.display = "";
  }

  // --- the JSON stores -------------------------------------------------------
  // Script nodes hold one value per condition: each card its figures, the
  // sequence strip its bases. Only the fetches below write them, and every
  // draw reads them, so a saved page draws from the same source as the live
  // page.
  function storeNode(root, cls, cond) {
    var nodes = root.querySelectorAll("script." + cls);
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i].getAttribute("data-cond") === cond) return nodes[i];
    }
    return null;
  }
  function writeStore(root, cls, cond, value) {
    var node = storeNode(root, cls, cond);
    if (!node) {
      node = document.createElement("script");
      node.type = "application/json";
      node.className = cls;
      node.setAttribute("data-cond", cond);
      root.appendChild(node);
    }
    node.textContent = JSON.stringify(value).replace(/<\\//g, "<\\\\/");
  }
  function readStore(root, cls, cond) {
    var node = storeNode(root, cls, cond);
    if (!node || !node.textContent) return null;
    return JSON.parse(node.textContent);
  }
  function cardOf(div) {
    return div.closest("details.plot-details");
  }
  function drawFromStore(div) {
    var fig = readStore(cardOf(div), "figstore", div.getAttribute("data-cond"));
    if (!fig) { hideCard(div); return; }
    showCard(div);
    drawInto(div, fig, figKind(div), figName(specOf(div)));
  }
  // Fetches the named conditions' figures for this card into its store,
  // drawing the condition on view as soon as its figure lands. Every
  // condition is fetched where none are named.
  function renderCard(div, conds) {
    if (!ONLINE) return Promise.resolve();
    var card = cardOf(div);
    var kind = div.getAttribute("data-kind");
    var ref = div.getAttribute("data-ref");
    return Promise.all((conds || CONDS).map(function (cond) {
      return fetchFigure({kind: kind, cond: cond, ref: ref}).then(function (fig) {
        writeStore(card, "figstore", cond, fig);
        if (cond === div.getAttribute("data-cond")) drawFromStore(div);
      });
    }));
  }
  function renderCards(conds) {
    var divs = document.querySelectorAll(".plot[data-kind]");
    var done = [];
    for (var i = 0; i < divs.length; i++) done.push(renderCard(divs[i], conds));
    redrawComparisons();
    return Promise.all(done);
  }
  function renderAll() {
    return renderCards(null);
  }
  function renderCondition(cond) {
    return renderCards([cond]);
  }
  function drawAllFromStores() {
    var divs = document.querySelectorAll(".plot[data-kind]");
    for (var i = 0; i < divs.length; i++) drawFromStore(divs[i]);
  }

  // Plotly typed-array-encodes numeric data as {dtype, bdata: base64}; decode
  // to an indexable array so the sequence strip can read the profile.
  function decodeArray(v) {
    if (!v || typeof v.bdata !== "string") return v;
    var bin = atob(v.bdata), n = bin.length, bytes = new Uint8Array(n);
    for (var i = 0; i < n; i++) bytes[i] = bin.charCodeAt(i);
    var CTOR = {f8: Float64Array, f4: Float32Array, i1: Int8Array, u1: Uint8Array,
                i2: Int16Array, u2: Uint16Array, i4: Int32Array, u4: Uint32Array};
    return new (CTOR[v.dtype] || Float64Array)(bytes.buffer);
  }
  function reactivityOf(fig) {
    for (var i = 0; i < fig.data.length; i++) {
      if (fig.data[i].name === "Reactivity") return decodeArray(fig.data[i].y);
    }
    return null;
  }

  // --- the colored sequence strip --------------------------------------------
  function currentRef() {
    var sel = document.getElementById("refselect");
    return sel ? sel.value : "0";
  }
  function seqColor(v) {
    if (v === null || v === undefined || isNaN(v)) return "var(--muted)";
    var t = Math.max(0, Math.min(1, v));
    return "rgb(" + Math.round(255 + (118 - 255) * t) + ","
                  + Math.round(255 + (42 - 255) * t) + ","
                  + Math.round(255 + (131 - 255) * t) + ")";
  }
  // The color scale spans the profile's 95th percentile, so raw rates and
  // normalized reactivities color alike.
  function seqScale(react) {
    if (!react) return 1;
    var vals = [];
    for (var i = 0; i < react.length; i++) {
      if (isFinite(react[i]) && react[i] > 0) vals.push(react[i]);
    }
    if (!vals.length) return 1;
    vals.sort(function (a, b) { return a - b; });
    return vals[Math.floor(0.95 * (vals.length - 1))] || 1;
  }
  function fetchSequence(cond, ref) {
    var spec = JSON.stringify({cond: cond, ref: ref});
    return fetch("sequence?spec=" + encodeURIComponent(spec))
      .then(function (r) { return r.ok ? r.text() : null; })
      .catch(function () { return null; });
  }
  function seqWrap() {
    var div = document.getElementById("seqview");
    return div ? div.closest(".seqview-wrap") : null;
  }
  // Fetches every condition's bases at the current reference into the
  // strip's store.
  function fetchSequences() {
    var wrap = seqWrap();
    if (!wrap || !ONLINE) return Promise.resolve();
    var ref = currentRef();
    return Promise.all(CONDS.map(function (cond) {
      return fetchSequence(cond, ref).then(function (bases) {
        writeStore(wrap, "seqstore", cond, bases);
      });
    }));
  }
  function profileStoreFigure(cond) {
    var div = document.querySelector('.plot[data-kind="' + KINDS.profile + '"]');
    if (!div) return null;
    return readStore(cardOf(div), "figstore", cond);
  }
  // The strip shows the selected condition's own sequence, colored by its
  // profile, so a wild-type and a mutant condition each show their own bases.
  // Both come from the stores, so the strip follows the chips offline too.
  function colorSeqview() {
    var wrap = seqWrap();
    if (!wrap) return;
    var div = document.getElementById("seqview");
    var cond = activeCond();
    var letters = readStore(wrap, "seqstore", cond);
    if (!letters) { wrap.hidden = true; return; }
    wrap.hidden = false;
    var fig = profileStoreFigure(cond);
    var react = fig ? reactivityOf(fig) : null;
    var scale = seqScale(react);
    var html = "";
    for (var i = 0; i < letters.length; i++) {
      html += '<span class="base" style="color:' + seqColor(react ? react[i] / scale : null) + '">'
            + letters[i] + "</span>";
    }
    div.innerHTML = html;
  }

  // --- the statistics --------------------------------------------------------
  // The fragment arrives with the first condition active, so the condition on
  // view is applied to the blocks that replace it.
  function fetchStats(box, ref) {
    if (!box || !ONLINE) return;
    var spec = {ref: ref, channels: channelMap()};
    fetch("stats?spec=" + encodeURIComponent(JSON.stringify(spec)))
      .then(function (r) { return r.ok ? r.text() : ""; })
      .then(function (html) {
        if (html) {
          box.innerHTML = html;
          showCondBlocks(activeCond());
        }
      })
      .catch(function () {});
  }
  function refreshStats() {
    fetchStats(document.getElementById("stats-main"), null);
    fetchStats(document.getElementById("stats-perseq"), currentRef());
  }

  // --- the condition chips ---------------------------------------------------
  // One chip row holds the condition the whole page is shown for, so every
  // figure and every statistic on screen comes from the one file.
  function activeCond() {
    var btn = document.querySelector(".controls .cond-btn.active");
    return btn ? btn.getAttribute("data-cond") : CONDS[0];
  }
  function showCondBlocks(cond) {
    var blocks = document.querySelectorAll(".cond-stats");
    for (var i = 0; i < blocks.length; i++) {
      blocks[i].classList.toggle("active", blocks[i].getAttribute("data-cond") === cond);
    }
  }
  function showCondPlots(cond) {
    var divs = document.querySelectorAll(".plot[data-kind]");
    for (var i = 0; i < divs.length; i++) {
      divs[i].setAttribute("data-cond", cond);
      drawFromStore(divs[i]);
    }
  }
  function applyCondition(cond) {
    showCondPlots(cond);
    showCondBlocks(cond);
    showChannels(cond);
    colorSeqview();
  }
  function bindConditionChips() {
    var btns = document.querySelectorAll(".controls .cond-btn");
    for (var i = 0; i < btns.length; i++) {
      btns[i].addEventListener("click", function () {
        var cond = this.getAttribute("data-cond");
        for (var j = 0; j < btns.length; j++) {
          btns[j].classList.toggle("active", btns[j].getAttribute("data-cond") === cond);
        }
        applyCondition(cond);
      });
    }
  }

  // --- the reference dropdown ------------------------------------------------
  function bindReferenceSelect() {
    var sel = document.getElementById("refselect");
    if (!sel) return;
    sel.addEventListener("change", function () {
      var plots = document.querySelectorAll(".perseq-plot");
      var done = [];
      for (var i = 0; i < plots.length; i++) {
        plots[i].setAttribute("data-ref", sel.value);
        done.push(renderCard(plots[i]));
      }
      fetchStats(document.getElementById("stats-perseq"), sel.value);
      done.push(fetchSequences());
      Promise.all(done).then(colorSeqview);
    });
  }

  // --- the multi-plot and difference selectors -------------------------------
  function makeRow(onChange, removable) {
    var row = document.createElement("div");
    row.className = "row";
    var condSel = document.createElement("select");
    row.appendChild(condSel);
    var refSel = document.createElement("select");
    row.appendChild(refSel);
    if (CONDS.length > 1) {
      var copts = "";
      for (var c = 0; c < CONDS.length; c++)
        copts += "<option>" + CONDS[c] + "</option>";
      condSel.innerHTML = copts;
    } else {
      condSel.innerHTML = "<option>" + CONDS[0] + "</option>";
      condSel.style.display = "none";
    }
    // The reference picker reaches only the selected condition's references,
    // keeps its selection when the new condition still holds it, and hides
    // for a single-reference condition.
    function refreshRefs() {
      var n = refCountOf(condSel.value);
      var kept = Math.min(parseInt(refSel.value || "0", 10), n - 1);
      if (n > 1) {
        var opts = "";
        for (var i = 0; i < n; i++)
          opts += '<option value="' + i + '">Reference ' + (i + 1) + "</option>";
        refSel.innerHTML = opts;
        refSel.value = String(kept);
        refSel.style.display = "";
      } else {
        refSel.innerHTML = '<option value="0"></option>';
        refSel.style.display = "none";
      }
    }
    refreshRefs();
    refSel.addEventListener("change", onChange);
    condSel.addEventListener("change", function () { refreshRefs(); onChange(); });
    if (removable) {
      var rm = document.createElement("button");
      rm.textContent = "−";
      rm.addEventListener("click", function () { row.parentNode.removeChild(row); onChange(); });
      row.appendChild(rm);
    }
    row._sel = function () {
      var ref = parseInt(refSel.value || "0", 10);
      var parts = [];
      if (CONDS.length > 1) parts.push(condSel.value);
      if (refCountOf(condSel.value) > 1) parts.push("Reference " + (ref + 1));
      return {cond: condSel.value, ref: ref, label: parts.join(" · "),
              channels: channelsOf(condSel.value)};
    };
    return row;
  }
  var redrawMulti = null;
  var redrawDiff = null;
  function redrawComparisons() {
    if (redrawMulti) redrawMulti();
    if (redrawDiff) redrawDiff();
  }
  function bindMultiPlot() {
    var rowsEl = document.getElementById("multiplot-rows");
    var addBtn = document.getElementById("multiplot-add");
    var plot = document.getElementById("multiplot");
    if (!rowsEl || !plot) return;
    function redraw() {
      var series = [], rows = rowsEl.querySelectorAll(".row");
      for (var i = 0; i < rows.length; i++) series.push(rows[i]._sel());
      fetchFigure({kind: KINDS.overlay, series: series}).then(function (fig) {
        if (fig) drawInto(plot, fig, "wide", "reactivity-overlay");
      });
    }
    redrawMulti = redraw;
    addBtn.addEventListener("click", function () { rowsEl.appendChild(makeRow(redraw, true)); redraw(); });
    rowsEl.appendChild(makeRow(redraw, true));
  }
  function bindDiffPlot() {
    var rowsEl = document.getElementById("diff-rows");
    var plot = document.getElementById("diffplot");
    if (!rowsEl || !plot) return;
    function redraw() {
      fetchFigure({kind: KINDS.difference, a: rowA._sel(), b: rowB._sel()}).then(function (fig) {
        if (fig) drawInto(plot, fig, "wide", "reactivity-difference");
      });
    }
    redrawDiff = redraw;
    var rowA = makeRow(redraw, false), rowB = makeRow(redraw, false);
    var op = document.createElement("span");
    op.className = "diff-op"; op.textContent = "minus";
    rowsEl.appendChild(rowA); rowsEl.appendChild(op); rowsEl.appendChild(rowB);
  }

  // --- resize (a figure drawn while its section is collapsed has zero size) ---
  function bindCollapsibleResize() {
    var ds = document.querySelectorAll("details");
    for (var i = 0; i < ds.length; i++) {
      ds[i].addEventListener("toggle", function () {
        if (!this.open) return;
        var plots = this.querySelectorAll(".js-plotly-plot, .plotly-graph-div");
        for (var j = 0; j < plots.length; j++) {
          if (plots[j].offsetWidth > 0) { try { Plotly.Plots.resize(plots[j]); } catch (e) {} }
        }
      });
    }
  }

  // --- startup / offline handling --------------------------------------------
  // A snapshot keeps the stores, so the condition chips stay live; only the
  // controls that make the server recompute are disabled.
  function goOffline() {
    var note = document.querySelector(".offline-note");
    if (note) note.hidden = false;
    var controls = document.querySelectorAll("select, input, button:not(.cond-btn)");
    for (var i = 0; i < controls.length; i++) {
      controls[i].disabled = true;
      controls[i].classList.add("disabled");
    }
  }
  function probe() {
    return fetch("health").then(function (r) { return r.ok; }).catch(function () { return false; });
  }
  document.addEventListener("DOMContentLoaded", function () {
    probe().then(function (online) {
      ONLINE = online;
      readChannelStores();
      bindConditionChips();
      showChannels(activeCond());
      bindCollapsibleResize();
      if (!online) {
        goOffline();
        drawAllFromStores();
        colorSeqview();
        return;
      }
      bindChannels();
      bindReferenceSelect();
      bindMultiPlot();
      bindDiffPlot();
      Promise.all([renderAll(), fetchSequences()]).then(colorSeqview);
    });
  });
})();
"""


# ===========================================================================
# The server
# ===========================================================================


# What a bad request raises: malformed specs, unknown names and references,
# and files that cannot be read. Every endpoint answers these with a 400.
REQUEST_FAILURES = (json.JSONDecodeError, KeyError, ValueError, IndexError, OSError)


class ReportServer(ThreadingHTTPServer):
    """Serves one report: the pre-built shell and figures over the files."""

    daemon_threads = True

    def __init__(self, address, conditions, shell):
        super().__init__(address, Handler)
        self.conditions = conditions
        self.shell = shell


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802 (the stdlib API)
        route = urlparse(self.path)

        if route.path in ("/", "/index.html"):
            self.reply(200, "text/html; charset=utf-8", self.server.shell.encode())
        elif route.path == "/health":
            self.reply(200, "text/plain", b"ok")
        elif route.path == "/figure":
            self.figure(parse_qs(route.query))
        elif route.path == "/stats":
            self.stats(parse_qs(route.query))
        elif route.path == "/sequence":
            self.sequence(parse_qs(route.query))
        else:
            self.reply(404, "text/plain", b"not found")

    def spec_of(self, query):
        return json.loads(query.get("spec", ["{}"])[0])

    def figure(self, query):
        try:
            fig = render_figure(self.server.conditions, self.spec_of(query))
        except REQUEST_FAILURES as error:
            self.reply(400, "text/plain", str(error).encode())
            return

        if fig is None:
            self.reply(404, "text/plain", b"no such figure")
            return

        self.reply(200, "application/json", fig.to_json().encode())

    def stats(self, query):
        try:
            spec = self.spec_of(query)
            ref = parse_ref(spec.get("ref"))
            channel_map = parse_channel_map(spec.get("channels"), self.server.conditions)
            body = stats_conditions_html(self.server.conditions, channel_map, ref)
        except REQUEST_FAILURES as error:
            self.reply(400, "text/plain", str(error).encode())
            return

        self.reply(200, "text/html; charset=utf-8", body.encode())

    def sequence(self, query):
        """Returns one condition's bases at one reference, so that the strip
        always shows the sequence of the selected chip."""
        try:
            spec = self.spec_of(query)
            path = condition_path(self.server.conditions, spec["cond"])

            with h5py.File(path, "r") as handle:
                bases = decode_sequence(handle, int(spec.get("ref", 0) or 0))
        except REQUEST_FAILURES as error:
            self.reply(400, "text/plain", str(error).encode())
            return

        if bases is None:
            self.reply(404, "text/plain", b"no sequence")
            return

        self.reply(200, "text/plain", bases.encode())

    def reply(self, code, content_type, body):
        self.send_response(code)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        """Keeps the terminal quiet."""


def serve(conditions, host, port):
    """Builds the shell, binds the server, prints the URL, and waits."""
    shell = build_shell(conditions)
    server = ReportServer((host, port), conditions, shell)
    url = f"http://{host}:{server.server_port}/"

    print(f"\n  cmuts plot -- report serving at\n\n      {url}\n", flush=True)
    print("  Open the link in your browser. Press Ctrl-C to stop.\n", flush=True)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.shutdown()
        server.server_close()
        print("\n  cmuts plot -- stopped.\n")


# ===========================================================================
# The command line
# ===========================================================================


def stem_of(path):
    name = path.rsplit("/", 1)[-1]

    if "." not in name:
        return name

    return name.rsplit(".", 1)[0]


def pair_labels(files, labels):
    """Returns one Condition per file. A --label applies to the file in the
    same position, and a file without one is labeled by its stem."""
    if len(labels) > len(files):
        raise SystemExit(f"cmuts-plot: {len(labels)} labels given for {len(files)} files")

    padded = labels + [stem_of(f) for f in files[len(labels):]]

    return [Condition(label, path) for label, path in zip(padded, files)]


def parse_arguments():
    parser = argparse.ArgumentParser(
        prog="cmuts plot",
        description="Serve an interactive HTML report over cmuts outputs.",
    )
    parser.add_argument("files", nargs="+", metavar="HDF5",
                        help="outputs to show, one condition each")
    parser.add_argument("--label", action="append", default=[], metavar="NAME",
                        help="label for the file in the same position "
                             "(default: the file's stem)")
    parser.add_argument("--host", default="127.0.0.1",
                        help="host to bind (default: 127.0.0.1)")
    parser.add_argument("--port", type=int, default=0,
                        help="port to bind (default: an OS-chosen free port)")
    parser.add_argument("-V", "--version", action="version",
                        version=f"cmuts plot v{VERSION}")

    # Intermixed parsing accepts a --label between files. Both lists keep
    # command-line order, and the first n labels name the first n files.
    return parser.parse_intermixed_args()


def main():
    arguments = parse_arguments()
    conditions = pair_labels(arguments.files, arguments.label)
    refused = check_conditions(conditions)

    if refused is not None:
        raise SystemExit(f"cmuts-plot: {refused}")

    serve(conditions, arguments.host, arguments.port)


if __name__ == "__main__":
    main()
